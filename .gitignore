# Dependencies
node_modules/

# Build artifacts
/dist/
/build/
/output/
/*.js   # Ignore all compiled JS files in the root (adjust as needed based on your tsconfig.json outDir)
/*.map  # Ignore all source map files in the root

# TypeScript declaration files (usually generated, but sometimes tracked)
# typings/

# Environment files
.env
.env.local
.env.*.local

# Testing and coverage
coverage/
.nyc_output/

# Logs and other temporary files
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# IDE and OS files
.vscode/   # VS Code configuration (optional, if you don't want to share workspace settings)
.idea/     # IntelliJ IDEA
.DS_Store  # macOS
Thumbs.db  # Windows

# Next.js
.next/

# SvelteKit
.svelte-kit/

# Optional: keep an example environment file
!.env.example
